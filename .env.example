# Base de datos (Vercel Postgres las genera automáticamente al conectar la integración)
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Auth.js
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console > Credentials > OAuth Client ID > Web application)
# Redirect URI: http://localhost:3000/api/auth/callback/google (y la de producción)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Notificaciones push (genera con: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com

# Protege el endpoint de Vercel Cron
CRON_SECRET=

# Panel de superadmin (/admin) — correos autorizados, separados por comas
SUPERADMIN_EMAILS=tucorreo@ejemplo.com

# Facturación manual (prueba gratis 30 días → pago mensual)
PLAN_PRICE_USD=10
PAYMENT_INFO_PAGOMOVIL="Banco: XXXXX\nTeléfono: 0412-0000000\nCédula/RIF: V-00000000"
PAYMENT_INFO_ZELLE="correo@ejemplo.com — Nombre del titular"
PAYMENT_INFO_BINANCE="Binance Pay ID: 000000000"
