{
  "name": "abasto-os-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --accept-data-loss --skip-generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "vapid:generate": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "next-auth": "5.0.0-beta.25",
    "@auth/prisma-adapter": "^2.7.2",
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "prisma": "^5.18.0",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.13",
    "@types/react": "^18.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/web-push": "^3.6.3"
  }
}
